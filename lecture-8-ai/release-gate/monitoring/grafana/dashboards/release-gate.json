{
  "uid": "release-gate",
  "title": "release gate",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Запуски за 5 минут",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(n8n_workflow_started_total[5m]))",
          "legendFormat": "started"
        },
        {
          "refId": "B",
          "expr": "sum(increase(n8n_workflow_success_total[5m]))",
          "legendFormat": "success"
        },
        {
          "refId": "C",
          "expr": "sum(increase(n8n_workflow_failed_total[5m]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Активные сценарии",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "n8n_active_workflow_count",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(release_gate_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
